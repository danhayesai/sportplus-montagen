---
import Figure from './Figure.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Sector name, e.g. "Sporthallen" - shown as the card's caption. */
  sectorTitle: string;
}

const { project, sectorTitle } = Astro.props;
---

<article class="project-card">
  <Figure src={project.image} alt={sectorTitle} width={800} height={600} />
  <span class="project-card__type">{sectorTitle}</span>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .project-card__type {
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
