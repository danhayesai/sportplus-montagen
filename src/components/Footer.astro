---
import Logo from './Logo.astro';
import { site, getFormattedAddress } from '../config/site';
import {
  getContent,
  getPath,
  getNavLabel,
  primaryNavKeys,
  type Language,
} from '../i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getContent(lang);
const year = new Date().getFullYear();

const navLinks = primaryNavKeys.map((key) => ({
  href: getPath(key, lang),
  label: getNavLabel(key, lang),
}));

const legalLinks = (['imprint', 'privacy'] as const).map((key) => ({
  href: getPath(key, lang),
  label: getNavLabel(key, lang),
}));
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo />
      <p class="site-footer__about">{t.footer.about}</p>
    </div>

    <nav class="site-footer__column" aria-label={t.footer.quickLinksTitle}>
      <h2 class="site-footer__heading">{t.footer.quickLinksTitle}</h2>
      <ul class="site-footer__list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__column">
      <h2 class="site-footer__heading">{t.footer.contactTitle}</h2>
      <ul class="site-footer__list">
        <li>
          <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
        </li>
        <li>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
        <li class="site-footer__address">{getFormattedAddress()}</li>
      </ul>
    </div>

    <nav class="site-footer__column" aria-label={t.footer.legalTitle}>
      <h2 class="site-footer__heading">{t.footer.legalTitle}</h2>
      <ul class="site-footer__list">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {site.legalName}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: var(--space-3xl);
    background-color: var(--color-bg-inverse);
    color: var(--color-text-inverse-muted);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    /* The brand block gets a little more room than the link columns. */
    grid-column: span 1;
    min-width: 0;
  }

  @media (min-width: 62rem) {
    .site-footer__brand {
      grid-column: span 2;
      max-width: 26rem;
    }
  }

  .site-footer__brand :global(.logo__name),
  .site-footer__brand :global(.logo__mark) {
    color: var(--color-text-inverse);
  }

  .site-footer__brand :global(.logo__suffix) {
    color: var(--color-text-inverse-muted);
  }

  .site-footer__about {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .site-footer__heading {
    margin-bottom: var(--space-md);
    color: var(--color-text-inverse);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .site-footer__list a {
    color: var(--color-text-inverse-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .site-footer__list a:hover {
    color: var(--color-text-inverse);
    text-decoration: underline;
  }

  .site-footer__address {
    line-height: var(--leading-relaxed);
  }

  .site-footer__bottom {
    padding-block: var(--space-lg);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--text-xs);
  }
</style>
