---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';
import ProjectCard from '../ProjectCard.astro';
import { getProjectsForSector, type Project } from '../../data/projects';
import { getContent, getActiveSectors, type Language } from '../../i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getContent(lang);
const references = t.references;
const sectors = getActiveSectors(lang);
---

<BaseLayout
  lang={lang}
  title={references.title}
  description={references.subtitle}
>
  <PageHero
    title={references.title}
    subtitle={references.subtitle}
    lead={references.lead}
  />

  {
    sectors.map((sector, index) => {
      const sectorProjects = getProjectsForSector(sector.id as Project['sectorId']);
      return (
        <section
          class:list={['section', index % 2 === 1 && 'section--subtle']}
          id={sector.id}
        >
          <div class="container">
            <div class="section-header">
              <span class="eyebrow">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="section-title">{sector.title}</h2>
              <p class="section-subtitle">{sector.body}</p>
            </div>

            <div class="gallery">
              {sectorProjects.map((project) => (
                <ProjectCard project={project} sectorTitle={sector.title} />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="section gallery-note">
    <div class="container container--narrow">
      <p>{references.galleryNote}</p>
    </div>
  </section>

  <CtaBand
    lang={lang}
    title={t.home.ctaBand.title}
    body={t.home.ctaBand.body}
    cta={t.home.ctaBand.cta}
  />
</BaseLayout>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-lg);
  }

  section[id] {
    scroll-margin-top: 5rem;
  }

  .gallery-note {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .gallery-note p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-style: italic;
  }
</style>
