---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ContactForm from '../ContactForm.astro';
import { site } from '../../config/site';
import { getContent, type Language } from '../../i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getContent(lang);
const contact = t.contact;
---

<BaseLayout lang={lang} title={contact.title} description={contact.subtitle}>
  <PageHero
    lang={lang}
    title={contact.title}
    subtitle={contact.subtitle}
    lead={contact.lead}
  />

  {/*
    Phone first, form second. In this trade most enquiries still come by
    telephone, and both closest competitors lead with a number rather than a
    form - but the form stays, because it catches the enquiries that arrive
    outside working hours.
  */}
  <section class="section section--subtle call-first">
    <div class="container call-first__inner">
      <div class="call-first__text">
        <h2 class="section-title">{contact.preferCallTitle}</h2>
        <p class="section-subtitle">{contact.preferCallBody}</p>
      </div>

      <div class="call-first__actions">
        <a
          class="button button--primary call-first__number"
          href={`tel:${site.contact.phoneHref}`}
        >
          {site.contact.phone}
        </a>
        <a class="call-first__email" href={`mailto:${site.contact.email}`}>
          {site.contact.email}
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-layout__form">
        <h2 class="contact-details__title">{contact.formTitle}</h2>
        <ContactForm lang={lang} />
      </div>

      <aside class="contact-layout__details">
        <h2 class="contact-details__title">{contact.directTitle}</h2>

        <dl class="contact-details">
          <div class="contact-details__row">
            <dt>{contact.phoneLabel}</dt>
            <dd>
              <a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
            </dd>
          </div>

          <div class="contact-details__row">
            <dt>{contact.emailLabel}</dt>
            <dd>
              <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            </dd>
          </div>

          <div class="contact-details__row">
            <dt>{contact.addressLabel}</dt>
            <dd>
              <address>
                {site.legalName}<br />
                {site.address.street}<br />
                {site.address.postalCode} {site.address.city}
              </address>
            </dd>
          </div>

        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .call-first__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .call-first__text {
    flex: 1 1 30rem;
    min-width: 0;
  }

  .call-first__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .call-first__number {
    font-size: var(--text-xl);
    white-space: nowrap;
  }

  .call-first__email {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .contact-layout__form > .contact-details__title {
    margin-bottom: var(--space-lg);
  }

  .contact-layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }

  @media (min-width: 62rem) {
    .contact-layout {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .contact-layout__details {
    padding: var(--space-xl);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .contact-details__title {
    margin-bottom: var(--space-lg);
    font-size: var(--text-xl);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0;
  }

  .contact-details__row dt {
    margin-bottom: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-details__row dd {
    margin: 0;
    font-size: var(--text-base);
  }

  .contact-details address {
    font-style: normal;
    line-height: var(--leading-relaxed);
  }
</style>
