---
import { withBase } from '../utils/url';
import manifest from '../data/image-manifest.json';

interface Props {
  /** Path relative to the site root, e.g. "/images/hero.jpg". */
  src: string;
  alt: string;
  /** Intrinsic dimensions. Always set both so the browser reserves the space. */
  width: number;
  height: number;
  /** Only the hero should load eagerly; everything else waits until near view. */
  loading?: 'lazy' | 'eager';
  /** CSS aspect-ratio value. Defaults to the 4:3 the gallery grids use. */
  ratio?: string;
  /**
   * How wide the image renders, so the browser can pick a variant before CSS
   * is applied. The default describes the gallery grid; the hero overrides it.
   */
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  ratio = '4 / 3',
  // 92vw rather than 100vw at the small end: the container has a gutter, so a
  // full-viewport figure would overstate the width and pull a larger variant.
  sizes = '(min-width: 62rem) 30vw, (min-width: 48rem) 45vw, 92vw',
  class: className,
} = Astro.props;

/**
 * The prebuild step (scripts/generate-webp.mjs) writes a WebP at each width in
 * the manifest, so the browser can take the smallest one that fits rather than
 * a 1600px original for a 400px slot. Anything not in the manifest falls back
 * to the plain <img> source untouched.
 */
const availableWidths = (manifest as Record<string, number[]>)[src] ?? [];
const webpBase = src.replace(/\.(jpe?g|png)$/i, '');
const srcset = availableWidths
  .map((w) => `${withBase(`${webpBase}-${w}.webp`)} ${w}w`)
  .join(', ');

const imgSrc = withBase(src);
---

<picture>
  {srcset && <source srcset={srcset} sizes={sizes} type="image/webp" />}
  <img
    class:list={['figure', className]}
    src={imgSrc}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={loading === 'eager' ? 'high' : undefined}
    style={`--figure-ratio: ${ratio}`}
  />
</picture>

<style>
  /* Keeps <picture> out of the layout entirely, so the <img> still sits
     directly in whatever grid or flex container the parent set up. */
  picture {
    display: contents;
  }

  .figure {
    width: 100%;
    height: auto;
    /* Matches the aspect ratio the placeholders reserved, so swapping an image
       for one of a different shape still crops rather than reflows. */
    aspect-ratio: var(--figure-ratio, 4 / 3);
    object-fit: cover;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
  }
</style>
