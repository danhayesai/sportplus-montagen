---
import { withBase } from '../utils/url';

interface Props {
  /** Path relative to the site root, e.g. "/images/hero.jpg". */
  src: string;
  alt: string;
  /** Intrinsic dimensions. Always set both so the browser reserves the space. */
  width: number;
  height: number;
  /** Only the hero should load eagerly; everything else waits until near view. */
  loading?: 'lazy' | 'eager';
  /** CSS aspect-ratio value. Defaults to the 4:3 the gallery grids use. */
  ratio?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  ratio = '4 / 3',
  class: className,
} = Astro.props;

/**
 * Every JPEG/PNG under public/ gets a WebP twin generated by the prebuild step
 * (scripts/generate-webp.mjs), so this path always exists alongside the
 * original. Browsers that support WebP take the smaller file; anything else
 * falls back to the <img> source untouched.
 */
const webpSrc = src.replace(/\.(jpe?g|png)$/i, '.webp');
const hasWebpTwin = webpSrc !== src;

// Callers pass logical, root-relative paths; the base is applied here so it is
// handled once for every image on the site rather than at each call site.
const imgSrc = withBase(src);
const imgWebpSrc = withBase(webpSrc);
---

<picture>
  {hasWebpTwin && <source srcset={imgWebpSrc} type="image/webp" />}
  <img
    class:list={['figure', className]}
    src={imgSrc}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={loading === 'eager' ? 'high' : undefined}
    style={`--figure-ratio: ${ratio}`}
  />
</picture>

<style>
  /* Keeps <picture> out of the layout entirely, so the <img> still sits
     directly in whatever grid or flex container the parent set up. */
  picture {
    display: contents;
  }

  .figure {
    width: 100%;
    height: auto;
    /* Matches the aspect ratio the placeholders reserved, so swapping an image
       for one of a different shape still crops rather than reflows. */
    aspect-ratio: var(--figure-ratio, 4 / 3);
    object-fit: cover;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
  }
</style>
