---
/**
 * Real artwork: a gear ring holding a try square, chisel and hammer arranged
 * as a "V", with "S+" as the standalone monogram (see public/favicon.svg).
 *
 * Supplied as a raster PNG (public/brand/), not vector, so it cannot use
 * currentColor to adapt between themes the way the rest of the site's icons
 * do. Instead there are two pre-rendered cutouts - navy for light backgrounds,
 * light for dark ones - and CSS shows whichever matches the active theme, the
 * same swap technique ThemeToggle.astro uses for its sun/moon icons.
 *
 * This is the icon-only crop (no "S+"), meant to sit beside the "SportPlus
 * Montagen" text below. The full lockup with "S+" lives in public/favicon.svg
 * and public/images/share.jpg, for contexts with no wordmark alongside it.
 */
---

<span class="logo">
  {/* WebP twins are generated by the prebuild step; the PNG stays as the
      fallback for anything that cannot take WebP. */}
  <picture>
    <source srcset="/brand/logo-mark-navy.webp" type="image/webp" />
    <img
      class="logo__mark logo__mark--navy"
      src="/brand/logo-mark-navy.png"
      alt=""
      width="589"
      height="568"
    />
  </picture>
  <picture>
    <source srcset="/brand/logo-mark-light.webp" type="image/webp" />
    <img
      class="logo__mark logo__mark--light"
      src="/brand/logo-mark-light.png"
      alt=""
      width="589"
      height="568"
    />
  </picture>

  <span class="logo__text">
    <span class="logo__name">SportPlus</span>
    <span class="logo__suffix">Montagen</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* <picture> must not become a flex item itself, or the two marks would
     occupy layout space even when their <img> is hidden. */
  .logo picture {
    display: contents;
  }

  .logo__mark {
    width: 2.3rem;
    height: auto;
    flex-shrink: 0;
  }

  /* Light theme (default): navy mark. Dark theme: light mark. Exactly one of
     the two is ever visible - see ThemeToggle.astro for the same pattern. */
  .logo__mark--light {
    display: none;
  }

  :root[data-theme='dark'] .logo__mark--navy {
    display: none;
  }

  :root[data-theme='dark'] .logo__mark--light {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .logo__mark--navy {
      display: none;
    }

    :root:not([data-theme='light']) .logo__mark--light {
      display: block;
    }
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__name {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .logo__suffix {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Hide the wordmark visually on very narrow screens but keep it in the
     accessibility tree, so the link never loses its accessible name. */
  @media (max-width: 24rem) {
    .logo__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
