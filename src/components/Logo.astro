---
/**
 * Wordmark drawn inline as SVG so it stays crisp at any size, inherits the
 * current text colour and costs no extra network request.
 *
 * Replace the mark with the official logo file when one is available; keep the
 * viewBox and the aria-label so layout and accessibility stay intact.
 */
---

<span class="logo">
  <svg
    class="logo__mark"
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="32" height="32" rx="7" fill="currentColor" opacity="0.1" />
    <!-- Stylised protective wall panel with a floor line beneath it -->
    <rect x="7" y="7" width="8" height="13" rx="1.6" fill="currentColor" />
    <rect
      x="17.5"
      y="7"
      width="8"
      height="13"
      rx="1.6"
      fill="currentColor"
      opacity="0.45"
    />
    <rect x="7" y="22.5" width="18.5" height="2.6" rx="1.3" fill="#f57c1f" />
  </svg>

  <span class="logo__text">
    <span class="logo__name">SportPlus</span>
    <span class="logo__suffix">Montagen</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .logo__mark {
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    color: var(--color-brand-600);
  }

  :root[data-theme='dark'] .logo__mark {
    color: var(--color-brand-300);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .logo__mark {
      color: var(--color-brand-300);
    }
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__name {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .logo__suffix {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Hide the wordmark visually on very narrow screens but keep it in the
     accessibility tree, so the link never loses its accessible name. */
  @media (max-width: 24rem) {
    .logo__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
