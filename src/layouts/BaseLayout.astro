---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import {
  getContent,
  getAlternatePath,
  languages,
  type Language,
} from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Language;
  /** Page title, without the company suffix. */
  title: string;
  /** Meta description. Falls back to the site-wide description. */
  description?: string;
  /** Set on the home page so the title is not duplicated. */
  isHome?: boolean;
  /** Emits FAQPage structured data. Only set on pages that render the FAQ. */
  includeFaqSchema?: boolean;
  /** Keeps a page out of search results (used by the 404). */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  isHome = false,
  includeFaqSchema = false,
  noindex = false,
} = Astro.props;

const t = getContent(lang);
const pathname = Astro.url.pathname;

const pageTitle = isHome
  ? `${site.shortName} — ${t.meta.tagline}`
  : `${title} | ${site.shortName}`;

const metaDescription = description ?? t.meta.description;
const canonicalUrl = new URL(pathname, site.url).href;

// Social previews need an absolute URL; a root-relative path is ignored by
// every major platform.
const shareImageUrl = new URL('/images/share.jpg', site.url).href;

// One alternate link per language, plus x-default pointing at German.
const alternates = (Object.keys(languages) as Language[]).map((code) => ({
  code,
  href: new URL(getAlternatePath(pathname, code), site.url).href,
}));

// LocalBusiness structured data helps the company surface in local search
// results and map listings.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.legalName,
  alternateName: site.shortName,
  description: metaDescription,
  url: site.url,
  telephone: site.contact.phoneHref,
  email: site.contact.email,
  vatID: site.legal.vatId,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.countryCode,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: site.openingHours.days,
      opens: site.openingHours.opens,
      closes: site.openingHours.closes,
    },
  ],
  image: shareImageUrl,
  logo: new URL('/brand/logo-mark-navy.png', site.url).href,
  // Tells search engines which regions this business actually covers, which
  // is what drives "near me" style local results.
  areaServed: site.areaServed.map((name) => ({
    '@type': 'AdministrativeArea',
    name,
  })),
  knowsLanguage: ['de', 'en'],
};

// Emitted only where the FAQ is actually rendered - marking up questions that
// are not visible on the page is a structured-data violation.
const faqSchema = includeFaqSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.code}
          href={alternate.href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(getAlternatePath(pathname, 'de'), site.url).href}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* iOS ignores SVG favicons, so it needs its own raster icon. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1b4272" />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:locale" content={t.meta.localeTag.replace('-', '_')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.media.shareAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={t.media.shareAlt} />

    <!-- Inter is self-hosted (see the @font-face rule in global.css), so there
         is no third-party font request. Preloading it lets the browser fetch
         the file alongside the stylesheet instead of waiting for it. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    {
      faqSchema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(faqSchema)}
        />
      )
    }

    <!-- Applies the saved theme before first paint so the page never flashes
         the wrong colour scheme. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (error) {
          /* localStorage unavailable - fall back to system preference */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t.meta.skipToContent}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
