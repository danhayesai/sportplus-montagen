---
import { site } from '../config/site';
import { withBase } from '../utils/url';

/**
 * Root entry point.
 *
 * Every real page lives under a language prefix, so `/` only routes visitors
 * onward - always to German, by meta refresh, with the visible links as the
 * fallback. Search engines then treat `/` as a permanent redirect to `/de/`,
 * which is what the canonical link and x-default say as well.
 *
 * There is deliberately no script here choosing a language from the browser.
 * An earlier version sent English-preferring browsers to `/en/`, and
 * Googlebot is one: it rendered `/`, followed the script to `/en/`, and
 * concluded the two were the same page - while `/` was declaring `/de/` as
 * its canonical. Search Console reported `/en/` as a duplicate with `/`
 * chosen over it. English speakers arriving here still get the switcher in
 * the header, and anyone arriving from a search result lands on `/en/`
 * directly, because hreflang tells Google which version to list.
 *
 * This page stays indexable on purpose: `/` is the address the old site
 * ranked under, so excluding it would discard that standing instead of
 * handing it to `/de/`.
 */
const origin = Astro.site ?? new URL(site.url);
const germanPath = withBase('/de/');
const englishPath = withBase('/en/');
const germanUrl = new URL(germanPath, origin).href;
const englishUrl = new URL(englishPath, origin).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.shortName}</title>
    <meta http-equiv="refresh" content={`0; url=${germanPath}`} />
    <link rel="canonical" href={germanUrl} />
    <link rel="alternate" hreflang="de" href={germanUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={germanUrl} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <style>
      body {
        margin: 0;
        display: grid;
        place-items: center;
        min-height: 100vh;
        font-family: system-ui, sans-serif;
        text-align: center;
      }

      a {
        display: inline-block;
        margin: 0.5rem;
        padding: 0.75rem 1.5rem;
        border: 1px solid currentColor;
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div>
      <p>{site.shortName}</p>
      <a href={germanPath} hreflang="de">Deutsch</a>
      <a href={englishPath} hreflang="en">English</a>
    </div>
  </body>
</html>
